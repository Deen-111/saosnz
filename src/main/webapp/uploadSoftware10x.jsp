<!doctype html>
<html lang="en">

<head>
<meta charset="utf-8">
<meta name="viewport"
	content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>Upload Software 10x</title>
</head>
<body>
	<div class="row">
		<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-12" >
			<div class="tab-outline">
				<form>
					<div class="form-group">
						<div class="card z-depth-0 bordered" style="max-height: 800px">
							<div class="card-header bg-header">
								<h5 class="mb-0">
									<input type="file" class="btn-xs float-left" accept=".zip"
										id="upload_software10x_file" name="software_file">
								</h5>
							</div>
							<div class="card z-depth-0 bordered"></div>

							<div class="card-footer ">
								<a class="btn border btn-xs bg-primary float-left"
									id="software10x_upload">Upload Software</a>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
	<script src="static/libs/js/uploadSoftware10x.js"></script>
</body>
</html>